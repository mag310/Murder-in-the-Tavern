{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "locations.schema.json",
    "title": "Location",
    "description": "Одна локация сценария. По одному файлу на локацию в каталоге locations/.",
    "type": "object",
    "required": [
        "id",
        "name",
        "type",
        "description",
        "characters",
        "important_events",
        "clues",
        "secrets"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "name": {
            "type": [
                "string",
                "null"
            ]
        },
        "type": {
            "type": "string",
            "enum": [
                "context",
                "gameplay"
            ]
        },
        "status": {
            "type": "string",
            "enum": [
                "optional",
                "needs_definition"
            ]
        },
        "parent_location": {
            "type": [
                "string",
                "null"
            ]
        },
        "description": {
            "type": "string"
        },
        "characters": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "important_events": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "clues": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "secrets": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "mechanical_features": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "appearance": {
            "$ref": "#/$defs/appearance"
        },
        "senses": {
            "$ref": "#/$defs/senses"
        },
        "hidden": {
            "type": "array",
            "description": "Скрытые детали локации: что можно найти при обыске/наблюдении. Текст описания + (по желанию) ссылки на улики.",
            "items": {
                "$ref": "#/$defs/hiddenDetail"
            }
        }
    },
    "additionalProperties": true,
    "$defs": {
        "appearance": {
            "type": [
                "string",
                "null"
            ],
            "description": "Визуальное описание локации: что видят персонажи (здания, предметы, освещение, атмосфера). Без ссылок на улики — только описание."
        },
        "senses": {
            "type": [
                "object",
                "null"
            ],
            "description": "Сенсорное описание локации: что слышат/чувствуют персонажи.",
            "properties": {
                "smell": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Запах (набор запахов в помещении)."
                },
                "sound": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Звуки (что слышно в помещении)."
                },
                "feeling": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Ощущение (атмосфера: тепло/холод/напряжение/страх)."
                }
            },
            "additionalProperties": true
        },
        "hiddenDetail": {
            "type": "object",
            "description": "Скрытая деталь локации (обнаруживается при обыске/наблюдении).",
            "properties": {
                "description": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Текстовое описание скрытой детали."
                },
                "evidence": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "description": "Ссылки на улики, обнаруживаемые здесь (ID из evidence.json).",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": true
        }
    }
}
