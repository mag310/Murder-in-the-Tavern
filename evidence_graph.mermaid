graph TD

    %% =========================================================
    %% ГРАФ УЛИК И ЗАЦЕПОК
    %% Ход чтения: ЛОКАЦИЯ (LO) -> ЗАЦЕПКА/УЛИКА (E) -> УСЛОВИЕ ПОЛУЧЕНИЯ
    %% (C) -> К ЧЕМУ ВЕДЁТ (B) -> ПУТЬ ОСТАНОВКИ ПОВОДА -> КОНЦОВКА (EN)
    %% Источник: evidence.json, locations/*.json, kill_grid.json,
    %%          murder_matrix.json, flood_mechanic.json, 05-endings.md
    %% =========================================================

    %% =========================================================
    %% 0. КЛАССЫ
    %% =========================================================
    classDef floor fill:#e8f5e9, stroke:#2e7d32;
    classDef basement fill:#d7f3ec, stroke:#00796b;
    classDef mansard fill:#f5e1d0, stroke:#c0592b;
    classDef outdoor fill:#e0f2f1, stroke:#00695c;
    classDef room2f fill:#f3e5f5, stroke:#6a1b9a;
    classDef town fill:#eceff1, stroke:#455a64;
    classDef primary fill:#d4edda, stroke:#2e7d32, stroke-width:2px;
    classDef secondary fill:#fff3cd, stroke:#b8960b;
    classDef falselead fill:#f8d7da, stroke:#c62828, stroke-dasharray:4 3;
    classDef accident fill:#e2e3e5, stroke:#495057, stroke-dasharray:2 2;
    classDef condition fill:#e1f5fe, stroke:#0288d1, stroke-dasharray:3 2;
    classDef scenario fill:#e1bee7, stroke:#6a1b9a, stroke-width:2px;
    classDef alibi fill:#d1ecf1, stroke:#0288d1, stroke-dasharray:2 2;
    classDef endingGood fill:#c8e6c9, stroke:#1b5e20, stroke-width:2px;
    classDef endingBad fill:#ffcdd2, stroke:#b71c1c, stroke-width:2px;

    %% =========================================================
    %% 1. ЛОКАЦИИ (узлы-источники улик)
    %% =========================================================

    subgraph LO1["1 этаж"]
        TKOFF["Кабинет трактирщика"]
        THALL["Общий зал"]
        KITCH["Кухня"]
    end

    subgraph LOB["Подвал (тонет 1-й, +1..+2 ч)"]
        CLAIR["Логово культа"]
        SMUG["Тайный склад контрабандистов"]
        BASE["Подвал/кладовая/ледник"]
    end

    subgraph LO2["2 этаж (тонет +19..+22 ч)"]
        WROOM["Комната Официантки"]
        SROOM["Комната Моряка"]
        DROOM["Комната Детектива"]
        DOCTOR["Комната Врача"]
    end

    subgraph LOM["Мансарда (тонет в последнюю, +23..+24 ч)"]
        MANS["Мастерская Художника"]
        ARTROOM["Жилая комната Художника"]
        A1["Чердак №1"]
    end

    subgraph LOO["Двор/набережная (тонут +2..+6 ч)"]
        YARD["Двор таверны"]
        GRAVE["Могила Жены"]
        QUAY["Набережная/причал"]
    end

    %% =========================================================
    %% 2. УЛИКИ И ЗАЦЕПКИ (role: primary / secondary / false / accident)
    %% =========================================================

    %% --- 1 этаж ---
    E_TB["Записная книжка трактирщика"]
    E_CON["Контрабанда: Погибель Дьявола / пеш / лист-живодёр / грязь"]
    E_TKN["Кинжал трактирщика"]
    E_THL["Дневник трактирщика (мотив мести)"]
