    E_POT["Флакон яда"]
    E_CRT["Счёт за контрабанду"]
    E_DN["Долговая расписка"]
    E_TKH["Тайник трактирщика"]

    %% --- подвал ---
    E_CI["Ритуальные предметы культа"]
    E_DAG["Ритуальный кинжал Врача"]
    E_SK["Реликвия ордена (ковчег с мумифицированным черепом)"]
