    %% =========================================================
    %% 6. ПУТЬ ОСТАНОВКИ ПОВОДА (потоп = заклинание Официантки)
    %% =========================================================
    P1["Смерть Моряка (цель заклинания)"]
    P2["Смерть Официантки (проводник)"]
    P3["Обратный ритуал Врача"]
    P4["Возврат реликвии Художнику"]
    P5["Отвязать ялик и переждать потоп"]

B_S21 --> P1
B_S24 --> P1
B_A36 --> P2
B_D54 --> P3
B_D65 --> P4
E_SK --> P4
E_AUR --> P5

    %% =========================================================
    %% 7. КОНЦОВКИ (flood_mechanic.endings)
    %%    solve/solve_only = убийца найден; flood_stop_only = потоп
    %%    остановлен; drown = провал. solve_only + drown = ВСЕ погибают.
    %% =========================================================
    EN_SOLVE["Solve — убийца найден + потоп остановлен"]
    EN_SOLO["Solve only — убийца найден, потоп НЕ остановлен (таверна тонет)"]
    EN_FLOOD["Flood only — потоп остановлен, убийца НЕ найден (таверна спасена)"]
    EN_DROWN["Drown — всё провалено (таверна утонет)"]

    %% пути остановки потопа (1-5) => спасение при найденном убийце
    P1 --> EN_SOLVE
    P2 --> EN_SOLVE
    P3 --> EN_SOLVE
    P4 --> EN_SOLVE
    P5 --> EN_SOLVE
    %% убийца найден, но потоп НЕ остановлен => таверна тонет
    B_S23 --> EN_SOLO
    B_A56 --> EN_SOLO
    %% потоп остановлен, но убийца не найден => таверна спасена
    B_ALIB --> EN_FLOOD
    %% ни убийца, ни потоп => провал
    B_ACC --> EN_DROWN
    %% при провале по времени путь_6 (продление) => утонуть
    EN_DROWN --> EN_DROWN:::endingBad

    %% =========================================================
    %% 8. ПРИМЕР ПУТИ (одна связка end-to-end, чтобы показать ход)
    %%    cult_lair -> reliquary_skull -> обыск под алтарём -> Художник
    %%    -> path_4 -> Solve; параллельно ложные следы -> ali/accident
    %% =========================================================
    CLAIR -.->|"пример пути"| E_SK
    E_SK -.->|"primary"| B_A36
    B_A36 -.->|"path_2"| P2
    P2 -.-> EN_SOLVE

    %% =========================================================
    %% 9. КЛАССЫ
    %% =========================================================
    class TKOFF,KITCH floor;
    class THALL floor;
    class BASE,CLAIR,SMUG basement;
    class MANS,ARTROOM,A1 mansard;
    class YARD,GRAVE,QUAY outdoor;
    class WROOM,SROOM,DROOM,DOCTOR room2f;

    class E_STL,E_WD,E_SK,E_ORD,E_DAG,E_CUB,E_DIARY,E_SKN primary;
    class E_CON,E_TB,E_CI,E_WP,E_THL,E_TKN,E_WF,E_WH,E_DH,E_DN2,E_POIS,E_GT,E_AUR,E_FS,E_TKH,E_CRT secondary;
    class E_SF,E_SKN,E_FLK,E_INK,E_NAU,E_DRK,E_ATR,E_MASK,E_CORD,E_POT,E_CUB falselead;
    class E_BLO,E_BB accident;
    class C_TKHID,C_OFF,C_HALL,C_CULT,C_ALT,C_SKULL,C_DAGPR,C_SKG,C_ATTIC,C_ART,C_MANS,C_WROOM,C_SROOM,C_DRK,C_DOCTOR,C_YARD,C_GRAVE,C_TOR condition;
    class B_S21,B_T12,B_S23,B_S44,B_S24,B_T41,B_A36,B_A46,B_A56,B_D54,B_D65,B_T61,B_T51,B_A16,B_S63,B_D21 scenario;
    class B_ALIB alibi;
    class B_ACC accident;
    %% EN_SOLVE = спасение; EN_FLOOD = таверна спасена (убийца не найден);
    %% EN_SOLO + EN_DROWN = все погибают (flood_mechanic.endings).
    class EN_SOLVE,EN_FLOOD endingGood;
    class EN_SOLO,EN_DROWN endingBad;