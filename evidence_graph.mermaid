    E_FS["Потоп как заклинание"]
    E_BLO["Мокрые следы во дворе"]
    E_AUR["Аура заклинания (тёмная магия)"]
    E_TOR["Сломанный нож (не подходит по ране)"]

    %% --- зал/могила ---
    E_WP["Портрет Жены"]
    E_BG["Семейное древо"]
    E_CSP["Речевые особенности культистов (водная одержимость)"]
    E_MSP2["Речевые особенности Художника (военный жаргон)"]
