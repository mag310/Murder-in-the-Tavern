    %% =========================================================
    %% 5. К ЧЕМУ ВЕДЁТ (branches: primary / secondary / false / accident)
    %%    proof = подводит к убийце; false = ложный след; alibi = очерчивает
    %% =========================================================

    B_S21["Моряк убил трактирщика · месть"]
    B_T12["Трактирщик убил Моряка · месть"]
    B_S23["Официантка убила Моряка · месть за мать / потоп-жертва"]
    B_S44["Врач убил Моряка · защита Официантки"]
    B_S24["Моряк убил Врача · самозащита (КАНОН)"]
    B_T41["Трактирщик убил Врача · защита дочери"]
    B_A36["Художник убил Официантку · реликвия (КАНОН)"]
    B_A46["Художник убил Врача · культист"]
    B_A56["Художник убил Детектива · скрыть охоту (КАНОН)"]
    B_D54["Врач убил Детектива · защита от пьяного"]
    B_D65["Детектив убил Художника · личное vs правосудие"]
