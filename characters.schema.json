{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "characters.schema.json",
    "title": "Characters",
    "type": "object",
    "required": [
        "project",
        "characters"
    ],
    "properties": {
        "project": {
            "type": "object",
            "required": [
                "title",
                "type",
                "setting"
            ],
            "properties": {
                "title": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "setting": {
                    "type": "object",
                    "required": [
                        "location",
                        "situation"
                    ],
                    "properties": {
                        "location": {
                            "type": "string"
                        },
                        "situation": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "characters": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/character"
            }
        }
    },
    "$defs": {
        "character": {
            "type": "object",
            "required": [
                "id",
                "name",
                "role",
                "status",
                "can_be_murder_victim",
                "small_secret",
                "big_secret",
                "relationships",
                "knowledge",
                "false_beliefs",
                "location_links"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "role": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "main_npc",
                        "context_npc"
                    ]
                },
                "can_be_murder_victim": {
                    "type": "boolean",
                    "description": "Может ли персонаж быть жертвой текущего убийства. true — для персонажей в таверне, false — для контекстных персонажей вне таверны"
                },
                "small_secret": {
                    "$ref": "#/$defs/secret"
                },
                "big_secret": {
                    "$ref": "#/$defs/secret"
                },
                "relationships": {
                    "$ref": "#/$defs/relationships"
                },
                "knowledge": {
                    "type": "array",
                    "description": "Уровни знаний персонажа о фактах сценария",
                    "items": {
                        "$ref": "#/$defs/knowledgeItem"
                    }
                },
                "false_beliefs": {
                    "type": "array",
                    "description": "Ложные убеждения персонажа (то, во что он верит, но что неверно)",
                    "items": {
                        "$ref": "#/$defs/falseBelief"
                    }
                },
                "location_links": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "external_links": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "investigation": {
                    "$ref": "#/$defs/investigation"
                },
                "employment": {
                    "$ref": "#/$defs/employment"
                },
                "current_murder": {
                    "$ref": "#/$defs/currentMurder"
                },
                "death": {
                    "$ref": "#/$defs/death"
                }
            },
            "additionalProperties": true
        },
        "death": {
            "type": "object",
            "required": [
                "killed_by",
                "cause",
                "status"
            ],
            "properties": {
                "killed_by": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "cause": {
                    "type": "string"
                },
                "event": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "secret": {
            "type": [
                "object",
                "null"
            ],
            "properties": {
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "target": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "known_by": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": true
        },
        "relationship": {
            "type": "object",
            "required": [
                "target",
                "type"
            ],
            "properties": {
                "target": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "relationships": {
            "type": "object",
            "required": [
                "love",
                "hatred",
                "money",
                "religion",
                "justice"
            ],
            "properties": {
                "love": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/relationship"
                    }
                },
                "hatred": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/relationship"
                    }
                },
                "money": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/relationship"
                    }
                },
                "religion": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/relationship"
                    }
                },
                "justice": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/relationship"
                    }
                }
            },
            "additionalProperties": true
        },
        "investigation": {
            "type": "object",
            "properties": {
                "employer": {
                    "type": [
                        "object",
                        "string",
                        "null"
                    ],
                    "description": "Наниматель/заказчик персонажа. Объект со сценариями (primary/secondary/alternative) или строка-ссылка на ID, или null."
                },
                "employer_note": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "case": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "actual_cause_of_previous_deaths": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reason_previous_deaths_are_connected_to_maniac": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reason_investigation_reached_tavern": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "additionalProperties": true
        },
        "employment": {
            "type": "object",
            "description": "Рабочая/служебная привязка персонажа: на кого работает, в каком статусе. Для контекста сценария, не обязательно связано с текущим убийством.",
            "properties": {
                "employer": {
                    "type": [
                        "object",
                        "string",
                        "null"
                    ],
                    "description": "Объект {primary/secondary/alternative} или строка-ID нанимателя/работодателя, или null."
                },
                "role": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Роль/должность (напр. 'работник таверны', 'деловой партнёр')."
                },
                "note": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "additionalProperties": true
        },
        "currentMurder": {
            "type": "object",
            "required": [
                "is_killer",
                "status"
            ],
            "properties": {
                "is_killer": {
                    "type": "boolean"
                },
                "status": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "knowledgeItem": {
            "type": "object",
            "required": [
                "level",
                "fact"
            ],
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "knows_exactly",
                        "knows_only",
                        "suspects",
                        "does_not_know"
                    ],
                    "description": "Уровень знания: knows_exactly (точно знает), knows_only (просто знает), suspects (подозревает), does_not_know (не знает)"
                },
                "fact": {
                    "type": "string",
                    "description": "Текст факта"
                },
                "target": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ID персонажа, о котором известно (или null, если факт не про персонажа)"
                },
                "reason": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Почему персонаж знает/подозревает (опционально)"
                },
                "source": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Источник знания: secret, relationship, event, observation, other"
                }
            },
            "additionalProperties": true
        },
        "falseBelief": {
            "type": "object",
            "required": [
                "belief",
                "correctness"
            ],
            "properties": {
                "belief": {
                    "type": "string",
                    "description": "Текст ложного убеждения"
                },
                "correctness": {
                    "type": "string",
                    "description": "Почему убеждение ложное (что реально)"
                },
                "source": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Источник заблуждения"
                },
                "confidence": {
                    "type": "string",
                    "enum": [
                        "high",
                        "medium",
                        "low"
                    ],
                    "description": "Насколько твёрдо персонаж верит в это убеждение"
                }
            },
            "additionalProperties": true
        }
    }
}
