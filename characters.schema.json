{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "characters.schema.json",
    "title": "Character",
    "description": "Один персонаж сценария. По одному файлу на персонаж в каталоге characters/.",
    "type": "object",
    "required": [
        "id",
        "name",
        "role",
        "status",
        "can_be_murder_victim",
        "relationships",
        "knowledge",
        "false_beliefs",
        "daily_schedule"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "name": {
            "type": [
                "string",
                "null"
            ]
        },
        "role": {
            "type": "string"
        },
        "status": {
            "type": "string",
            "enum": [
                "main_npc",
                "context_npc",
                "ghost"
            ],
            "description": "Статус персонажа: main_npc (основной персонаж в таверне), context_npc (контекстный вне таверны), ghost (мертвый персонаж — призрак, действующий в игре, но не живой и не жертва)."
        },
        "can_be_murder_victim": {
            "type": "boolean",
            "description": "Может ли персонаж быть жертвой текущего убийства. true — для персонажей в таверне, false — для контекстных персонажей вне таверны"
        },
        "secrets": {
            "type": [
                "array",
                "null"
            ],
            "description": "Массив тайн персонажа. Каждая тайна имеет level: 'small' (малая) или 'big' (большая). Заменяет прежние small_secret/big_secret (по одной).",
            "items": {
                "$ref": "#/$defs/secret"
            }
        },
        "relationships": {
            "$ref": "#/$defs/relationships"
        },
        "knowledge": {
            "type": "array",
            "description": "Уровни знаний персонажа о фактах сценария",
            "items": {
                "$ref": "#/$defs/knowledgeItem"
            }
        },
        "false_beliefs": {
            "type": "array",
            "description": "Ложные убеждения персонажа (то, во что он верит, но что неверно)",
            "items": {
                "$ref": "#/$defs/falseBelief"
            }
        },
        "daily_schedule": {
            "type": [
                "array",
                "null"
            ],
            "description": "Расписание дня: в какую часть суток в каком помещении обычно находится персонаж и что делает. Заменяет плоский location_links.",
            "items": {
                "$ref": "#/$defs/scheduleSlot"
            }
        },
        "organizations": {
            "type": [
                "array",
                "null"
            ],
            "description": "Организации/группировки, к которым относится персонаж. Ссылки на organizations/.",
            "items": {
                "$ref": "#/$defs/organizationMembership"
            }
        },
        "external_links": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "investigation": {
            "$ref": "#/$defs/investigation"
        },
        "employment": {
            "$ref": "#/$defs/employment"
        },
        "current_murder": {
            "$ref": "#/$defs/currentMurder"
        },
        "death": {
            "$ref": "#/$defs/death"
        }
    },
    "additionalProperties": true,
    "$defs": {
        "death": {
            "type": "object",
            "required": [
                "killed_by",
                "cause",
                "status"
            ],
            "properties": {
                "killed_by": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "cause": {
                    "type": "string"
                },
                "event": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "secret": {
            "type": [
                "object",
                "null"
            ],
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "small",
                        "big"
                    ],
                    "description": "Уровень тайны: small (малая) или big (большая)."
                },
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "target": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "known_by": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": true
        },
        "relationship": {
            "type": "object",
            "required": [
                "target",
                "type"
            ],
            "properties": {
                "target": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "relationships": {
            "type": "object",
            "required": [
                "love",
                "hatred",
                "money",
                "religion",
                "justice"
            ],
            "properties": {
                "love": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/relationship"
                    }
                },
                "hatred": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/relationship"
                    }
                },
                "money": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/relationship"
                    }
                },
                "religion": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/relationship"
                    }
                },
                "justice": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/relationship"
                    }
                }
            },
            "additionalProperties": true
        },
        "investigation": {
            "type": "object",
            "properties": {
                "employer": {
                    "type": [
                        "object",
                        "string",
                        "null"
                    ],
                    "description": "Наниматель/заказчик персонажа. Объект со сценариями (primary/secondary/alternative) или строка-ссылка на ID, или null."
                },
                "employer_note": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "case": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "actual_cause_of_previous_deaths": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reason_previous_deaths_are_connected_to_maniac": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "reason_investigation_reached_tavern": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "additionalProperties": true
        },
        "employment": {
            "type": "object",
            "description": "Рабочая/служебная привязка персонажа: на кого работает, в каком статусе. Для контекста сценария, не обязательно связано с текущим убийством.",
            "properties": {
                "employer": {
                    "type": [
                        "object",
                        "string",
                        "null"
                    ],
                    "description": "Объект {primary/secondary/alternative} или строка-ID нанимателя/работодателя, или null."
                },
                "role": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Роль/должность (напр. 'работник таверны', 'деловой партнёр')."
                },
                "note": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "additionalProperties": true
        },
        "scheduleSlot": {
            "type": "object",
            "required": [
                "time",
                "location"
            ],
            "properties": {
                "time": {
                    "type": "string",
                    "enum": [
                        "night",
                        "morning",
                        "day",
                        "evening",
                        "midnight"
                    ],
                    "description": "Часть суток: night (Ночь), morning (Утро), day (День), evening (Вечер), midnight (Полночь)."
                },
                "location": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ID локации из locations/, в которой обычно находится персонаж в это время суток."
                },
                "activity": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Что персонаж делает в это время (напр. 'обслуживает посетителей', 'молится', 'спит')."
                },
                "note": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Дополнительное пояснение (например, 'тайная смена', 'возможный сценарий')."
                }
            },
            "additionalProperties": true
        },
        "organizationMembership": {
            "type": "object",
            "required": [
                "organization"
            ],
            "properties": {
                "organization": {
                    "type": "string",
                    "description": "ID организации (из organizations/)."
                },
                "role": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Роль в организации (напр. 'ведущий', 'партнёр', 'последователь')."
                },
                "status": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Стatus членства: active / dead / left, или null."
                },
                "note": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "additionalProperties": true
        },
        "currentMurder": {
            "type": "object",
            "required": [
                "is_killer",
                "status"
            ],
            "properties": {
                "is_killer": {
                    "type": "boolean"
                },
                "status": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "knowledgeItem": {
            "type": "object",
            "required": [
                "level",
                "fact"
            ],
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "knows_exactly",
                        "knows_only",
                        "suspects",
                        "does_not_know"
                    ],
                    "description": "Уровень знания: knows_exactly (точно знает), knows_only (просто знает), suspects (подозревает), does_not_know (не знает)"
                },
                "fact": {
                    "type": "string",
                    "description": "Текст факта"
                },
                "target": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "ID персонажа, о котором известно (или null, если факт не про персонажа)"
                },
                "reason": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Почему персонаж знает/подозревает (опционально)"
                },
                "source": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Источник знания: secret, relationship, event, observation, other"
                }
            },
            "additionalProperties": true
        },
        "falseBelief": {
            "type": "object",
            "required": [
                "belief",
                "correctness"
            ],
            "properties": {
                "belief": {
                    "type": "string",
                    "description": "Текст ложного убеждения"
                },
                "correctness": {
                    "type": "string",
                    "description": "Почему убеждение ложное (что реально)"
                },
                "source": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Источник заблуждения"
                },
                "confidence": {
                    "type": "string",
                    "enum": [
                        "high",
                        "medium",
                        "low"
                    ],
                    "description": "Насколько твёрдо персонаж верит в это убеждение"
                }
            },
            "additionalProperties": true
        }
    }
}
