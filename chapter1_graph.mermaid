}%%
graph TD

    %% =========================================================
    %% ГЛАВА 1. ГОРОД (14:00–17:30)
    %% Ход: Событие (E, по порядку) -> Ветвь (B) -> Локация/улика (L)
    %%      -> Развилка (D) -> Соединение (C, слияние ветвей)
    %%      -> Переход в Главу 2 (H2)
    %% Источник: events.json (event_022–029), locations/*.json
    %% =========================================================

    %% =========================================================
    %% 0. КЛАССЫ
    %% =========================================================
    classDef start fill:#fff8e1, stroke:#f9a825, stroke-width:2px;
    classDef event fill:#e8f5e9, stroke:#2e7d32;
    classDef branch fill:#e1bee7, stroke:#6a1b9a;
    classDef location fill:#e1f5fe, stroke:#0288d1;
    classDef decision fill:#ffe0b2, stroke:#e65100, stroke-width:2px;
    classDef junction fill:#eceff1, stroke:#455a64, stroke-width:2px;
    classDef weather fill:#b3e5fc, stroke:#01579b;
    classDef clue fill:#fff3cd, stroke:#b8960b;
    classDef nextch fill:#f3e5f5, stroke:#6a1b9a, stroke-width:2px;

    %% =========================================================
    %% 1. СОБЫТИЯ (E, по игровому времени)
    %% =========================================================
    E22["14:00 · event_022\nИгроки в городе · приглашение к Дуксотару"]
    E23["15:00 · event_023\nВстреча с Дуксотаром · получение задания"]
    E24["16:00 · event_024\nМорг · отчёты о вскрытии · дорога к таверне"]
    E25["17:00–17:30 · event_025\nПрибытие · вид с моста (пристань + ялик)"]
    E26["17:30 · event_026\nВступление в таверну · знакомство с 5 NPC"]
    E29["19:00 · event_029\nЛивень · Детектив арендует комнату"]

    %% =========================================================
    %% 2. ВЕТВИ (параллельные ветви от события)
    %% =========================================================
    %% --- event_022: развилка ---
    B22a["Ветвь А · по приглашению к Дуксотару"]
    B22b["Ветвь Б · свободное расследование"]
    %% --- event_023: развилка ---
    B23a["Ветвь А · задание: найти маньяка (расчленение)"]
    B23b["Ветвь Б · тела — в морге"]
    %% --- event_024: развилка ---
    B24a["Ветвь А · осмотр трупов"]
    B24b["Ветвь Б · Доктор забрал отчёты о вскрытии"]
    %% --- event_025: развилка ---
    B25a["Ветвь А · видят пристань + ялик (путь спасения)"]
    B25b["Ветвь Б · ливень → бегут в таверну"]

    %% =========================================================
    %% 3. ЛОКАЦИИ / УЛИКИ (что в каждой ветви)
    %% =========================================================
    %% --- Ветвь А event_022 ---
    L22a["Тривардум · улицы Весткроуна"]
    %% --- Ветвь Б event_022 ---
    L22b["Улицы · места серии смертей (previous_crime_scenes)"]
    %% --- Ветви event_023 ---
    L23a["Задание: найти маньяка, расчленяющего тела"]
    L23b["Морг · невостребованные тела"]
    %% --- Ветви event_024 ---
    L24a["Осмотр трупов (визуально/автопсия)"]
    L24b["Ассистент Доктора (doctor_assistant)"]
    %% --- Ветви event_025 ---
    L25a["Пристань + ялик (путь спасения при потопе)"]
    L25b["Дорога к таверне (по следу Доктора)"]
    %% --- event_026 ---
    L26["Знакомство: Трактирщик · Официантка · Врач · Детектив · Моряк"]
    %% --- event_029 ---
    L29["Аренда комнаты · ливень · изоляция"]

    %% =========================================================
    %% 4. РАЗВИЛКИ (выбор игрока, event_022 / event_023)
    %% =========================================================
    D22{"event_022\nПо приглашению\nили свободное\nрасследование?"}
    D23{"event_023\nЗадание или\nтела в морге?"}

    %% =========================================================
    %% 5. СОЕДИНЕНИЯ (слияние ветвей, по игровому времени)
    %% =========================================================
    C231715["15:15 · гром · начало дождя\n(эскалация погоды)"]
    C24rain["Дождь усиливается · далеко идёт гроза"]
    C25storm["Дождь → проливной ливень"]

    %% =========================================================
    %% 6. АТМОСФЕРА (погода — параллельная ось, нарастание)
    %% =========================================================
    WX1["Облака затягивают небо (event_022)"]
    WX2["Гром + первый дождь (event_023, 15:15)"]
    WX3["Дождь усиливается, гроза (event_024)"]
    WX4["Проливной ливень (event_025)"]
    WX5["Ливень — изоляция (event_029)"]

    %% =========================================================
    %% 7. ПЕРЕХОД В ГЛАВУ 2
    %% =========================================================
    H2["Глава 2. Таверна\n(17:30–19:00)"]

    %% =========================================================
    %% 8. СВЯЗИ (E -> B -> L / D / C / WX / H2)
    %% =========================================================

    %% --- событие -> ветвь ---
    E22 --> D22
    D22 --> B22a
    D22 --> B22b
    E23 --> D23
    D23 --> B23a
    D23 --> B23b
    E24 --> B24a
    E24 --> B24b
    E25 --> B25a
    E25 --> B25b
    E26 --> L26
    E29 --> L29

    %% --- ветвь -> локация/улика ---
    B22a --> L22a
    B22b --> L22b
    B23a --> L23a
    B23b --> L23b
    B24a --> L24a
    B24b --> L24b
    B25a --> L25a
    B25b --> L25b

    %% --- развилка -> развилка ---
    D22 --> D23
    D23 --> C231715

    %% --- время: событие -> следующее событие (хронологический стержень) ---
    E22 --> E23
    E23 --> E24
    E24 --> E25
    E25 --> E26
    E26 --> E29

    %% --- соединение (слияние ветвей / погода) ---
    C231715 --> C24rain
    C24rain --> C25storm

    %% --- атмосфера: параллельная ось погоды (по времени) ---
    E22 -.-> WX1
    E23 -.-> WX2
    E24 -.-> WX3
    E25 -.-> WX4
    E29 -.-> WX5
    WX1 -.-> WX2
    WX2 -.-> WX3
    WX3 -.-> WX4
    WX4 -.-> WX5

    %% --- переход в Главу 2 ---
    E26 --> H2
    E29 --> H2
    C25storm -.->|"давление"| H2

    %% =========================================================
    %% 9. КЛАССЫ
    %% =========================================================
    class E22 start;
    class E23,E24,E25,E26,E29 event;
    class B22a,B22b,B23a,B23b,B24a,B24b,B25a,B25b branch;
    class L22a,L22b,L23a,L23b,L24a,L24b,L25a,L25b,L26,L29 location;
    class D22,D23 decision;
    class C231715,C24rain,C25storm junction;
    class WX1,WX2,WX3,WX4,WX5 weather;
    class H2 nextch;